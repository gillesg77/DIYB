<Application
    x:Class="DIYB.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:DIYB.App">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="StateOnBrush" Color="#0E6A32" />
                    <SolidColorBrush x:Key="StateOnFillBrush" Color="#D8F1E1" />
                    <SolidColorBrush x:Key="StateOffBrush" Color="#5D6570" />
                    <SolidColorBrush x:Key="StateOffFillBrush" Color="#E8EAED" />
                    <SolidColorBrush x:Key="DriftBrush" Color="#B54708" />
                    <SolidColorBrush x:Key="DriftFillBrush" Color="#FCEBD8" />
                    <SolidColorBrush x:Key="UpdateBrush" Color="#0B5FA5" />
                    <SolidColorBrush x:Key="SignalBrush" Color="#4A7FB5" />
                    <SolidColorBrush x:Key="RowSeparatorBrush" Color="#14000000" />
                    <SolidColorBrush x:Key="HeaderFillBrush" Color="#0A000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="StateOnBrush" Color="#5BE08D" />
                    <SolidColorBrush x:Key="StateOnFillBrush" Color="#1B3A28" />
                    <SolidColorBrush x:Key="StateOffBrush" Color="#A7AEB8" />
                    <SolidColorBrush x:Key="StateOffFillBrush" Color="#2A2E34" />
                    <SolidColorBrush x:Key="DriftBrush" Color="#FBBF24" />
                    <SolidColorBrush x:Key="DriftFillBrush" Color="#3A2E15" />
                    <SolidColorBrush x:Key="UpdateBrush" Color="#7FB6F5" />
                    <SolidColorBrush x:Key="SignalBrush" Color="#8FB6DE" />
                    <SolidColorBrush x:Key="RowSeparatorBrush" Color="#1AFFFFFF" />
                    <SolidColorBrush x:Key="HeaderFillBrush" Color="#12FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <app:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <app:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <app:StateBrushConverter x:Key="StateBrush" />

            <!-- Surface posée sur le matériau de la fenêtre : sans elle, tout se fond
                 en un aplat uniforme. -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <Style x:Key="PillStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="9,2" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="BadgeTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>

            <Style x:Key="ColumnHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="40" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="CellStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <!-- Bouton dépouillé : la couleur vient de la pastille qu'il contient. -->
            <Style x:Key="PillButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="2" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>

</Application>
