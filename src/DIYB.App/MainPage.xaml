<UserControl
    x:Class="DIYB.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DIYB.App.Controls"
    xmlns:vm="using:DIYB.App.ViewModels">

    <Grid x:Name="Root" Padding="16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Entête -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.Loc.Get('app.title'), Mode=OneWay}"
                           FontSize="24" FontWeight="SemiBold"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="{x:Bind ViewModel.Loc.Get('app.subtitle'), Mode=OneWay}"
                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <AutoSuggestBox Grid.Column="1" VerticalAlignment="Center" QueryIcon="Find"
                            PlaceholderText="{x:Bind ViewModel.Loc.Get('search.placeholder'), Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.Loc.Get('search.tooltip'), Mode=OneWay}"
                            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" />

            <ComboBox Grid.Column="2" x:Name="LanguageBox" VerticalAlignment="Center" MinWidth="130"
                      DisplayMemberPath="DisplayName"
                      SelectionChanged="OnLanguageChanged" />
        </Grid>

        <!-- Actions de masse -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="10">
            <controls:WrapPanel HorizontalSpacing="6" VerticalSpacing="6">
            <Button Content="{x:Bind ViewModel.Loc.Get('action.on'), Mode=OneWay}" Click="OnSwitchOn" MinWidth="72"
                    Style="{StaticResource AccentButtonStyle}" />
            <Button Content="{x:Bind ViewModel.Loc.Get('action.off'), Mode=OneWay}" Click="OnSwitchOff" MinWidth="72" />

            <Border Width="1" Margin="4,2" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <Button Content="{x:Bind ViewModel.Loc.Get('action.powerOnOn'), Mode=OneWay}" Click="OnStartupOn" />
            <Button Content="{x:Bind ViewModel.Loc.Get('action.powerOnKeep'), Mode=OneWay}" Click="OnStartupKeep" />
            <Button Content="{x:Bind ViewModel.Loc.Get('action.powerOnOff'), Mode=OneWay}" Click="OnStartupOff" />
            <Button Content="{x:Bind ViewModel.Loc.Get('action.inching'), Mode=OneWay}" Click="OnInching" />

            <Border Width="1" Margin="4,2" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <Button Content="{x:Bind ViewModel.Loc.Get('action.refresh'), Mode=OneWay}" Click="OnRefresh" />
            <Button Content="{x:Bind ViewModel.Loc.Get('action.rescan'), Mode=OneWay}" Click="OnRescan" />
            <Button Content="{x:Bind ViewModel.Loc.Get('action.changeWifi'), Mode=OneWay}" Click="OnWifi" />
            <Button Content="{x:Bind ViewModel.Loc.Get('action.firmwareFlash'), Mode=OneWay}" Click="OnFlash" />

            <Border Width="1" Margin="4,2" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <Button Content="{x:Bind ViewModel.Loc.Get('profile.title'), Mode=OneWay}" Click="OnProfile" />
            <Button Content="{x:Bind ViewModel.Loc.Get('action.checkUpdates'), Mode=OneWay}" Click="OnCheckUpdates" />

            <Button Content="&#xE712;" FontFamily="{ThemeResource SymbolThemeFontFamily}">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Name="SnapshotItem" Click="OnSnapshot" />
                        <MenuFlyoutItem x:Name="ExportItem" Click="OnExport" />
                        <MenuFlyoutItem x:Name="ImportItem" Click="OnImport" />
                        <MenuFlyoutSeparator />
                        <ToggleMenuFlyoutItem x:Name="ShowCloudItem" Click="OnToggleCloudDevices" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="AddSimulatedItem" Click="OnAddSimulated" />
                        <MenuFlyoutItem x:Name="ClearSimulatedItem" Click="OnClearSimulated" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            </controls:WrapPanel>
        </Border>

        <!-- Entête et lignes dans un même défilement horizontal : séparés, ils se
             désaligneraient dès que la fenêtre devient trop étroite. -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" CornerRadius="8">
            <Grid MinWidth="1240">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

        <!-- Entêtes de colonnes : marge et espacement identiques au gabarit de ligne,
             sans quoi le décalage s'accumule colonne après colonne. -->
        <Grid Grid.Row="0" Padding="12,8" ColumnSpacing="4" BorderThickness="0,0,0,1"
              CornerRadius="8,8,0,0" Background="{ThemeResource HeaderFillBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="2*" MinWidth="160" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="96" />
            </Grid.ColumnDefinitions>

            <CheckBox Grid.Column="0" MinWidth="0" x:Name="SelectAllBox" Click="OnToggleAll" />
            <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeaderStyle}" Text="{x:Bind ViewModel.Loc.Get('column.name'), Mode=OneWay}" />
            <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeaderStyle}" Text="{x:Bind ViewModel.Loc.Get('column.id'), Mode=OneWay}" />
            <TextBlock Grid.Column="3" Style="{StaticResource ColumnHeaderStyle}" Text="{x:Bind ViewModel.Loc.Get('column.state'), Mode=OneWay}" />
            <TextBlock Grid.Column="4" Style="{StaticResource ColumnHeaderStyle}" Text="{x:Bind ViewModel.Loc.Get('column.powerOn'), Mode=OneWay}" />
            <TextBlock Grid.Column="5" Style="{StaticResource ColumnHeaderStyle}" Text="{x:Bind ViewModel.Loc.Get('column.inching'), Mode=OneWay}" />
            <TextBlock Grid.Column="6" Style="{StaticResource ColumnHeaderStyle}" Text="{x:Bind ViewModel.Loc.Get('column.signal'), Mode=OneWay}" />
            <TextBlock Grid.Column="7" Style="{StaticResource ColumnHeaderStyle}" Text="{x:Bind ViewModel.Loc.Get('column.firmware'), Mode=OneWay}" />
            <TextBlock Grid.Column="8" Style="{StaticResource ColumnHeaderStyle}" Text="{x:Bind ViewModel.Loc.Get('column.compliance'), Mode=OneWay}" />
        </Grid>

        <!-- Liste des appareils -->
        <Grid Grid.Row="1">
            <ListView x:Name="DeviceList" ItemsSource="{x:Bind ViewModel.Devices, Mode=OneWay}"
                      SelectionMode="None" IsItemClickEnabled="False"
                      Background="Transparent" BorderThickness="0">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="46" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:DeviceRow">
                        <Grid Padding="12,4" ColumnSpacing="4" BorderThickness="0,0,0,1"
                              BorderBrush="{ThemeResource RowSeparatorBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="2*" MinWidth="160" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="96" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" MinWidth="0" VerticalAlignment="Center"
                                      IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />

                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0" Text="{x:Bind Name, Mode=OneWay}" BorderThickness="0"
                                         Background="Transparent" Padding="4,2"
                                         LostFocus="OnNameCommitted" KeyDown="OnNameKeyDown" />

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="3" Padding="5,1"
                                            Visibility="{x:Bind IsSimulated, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{x:Bind Loc.Get('simulator.badge'), Mode=OneWay}"
                                                   FontSize="10" Foreground="White" />
                                    </Border>

                                    <Border Background="{ThemeResource DriftBrush}" CornerRadius="3" Padding="5,1"
                                            ToolTipService.ToolTip="{x:Bind ModeHint, Mode=OneWay}"
                                            Visibility="{x:Bind RequiresKey, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{x:Bind Loc.Get('device.cloudBadge'), Mode=OneWay}"
                                                   FontSize="10" Foreground="White" />
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <TextBlock Grid.Column="2" Style="{StaticResource CellStyle}" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontFamily="Consolas" Text="{x:Bind DeviceId}" />

                            <Button Grid.Column="3" Style="{StaticResource PillButtonStyle}"
                                    IsEnabled="{x:Bind IsControllable, Mode=OneWay}" Click="OnRowToggle">
                                <Border Style="{StaticResource PillStyle}"
                                        Background="{x:Bind IsOn, Mode=OneWay, Converter={StaticResource StateBrush}, ConverterParameter=fill}">
                                    <TextBlock Text="{x:Bind StateText, Mode=OneWay}" Style="{StaticResource BadgeTextStyle}"
                                               Foreground="{x:Bind IsOn, Mode=OneWay, Converter={StaticResource StateBrush}}" />
                                </Border>
                            </Button>

                            <ComboBox Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                      IsEnabled="{x:Bind IsControllable, Mode=OneWay}"
                                      ItemsSource="{x:Bind StartupOptions, Mode=OneWay}"
                                      SelectedIndex="{x:Bind StartupIndex, Mode=TwoWay}"
                                      PlaceholderText="{x:Bind StartupText, Mode=OneWay}" />

                            <Button Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                    IsEnabled="{x:Bind IsControllable, Mode=OneWay}"
                                    Content="{x:Bind InchingText, Mode=OneWay}" Click="OnRowInching" />

                            <Grid Grid.Column="6" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource CellStyle}"
                                           Text="{x:Bind RssiText, Mode=OneWay}" FontSize="12" />
                                <controls:Sparkline Grid.Column="1" Height="22" Margin="8,0,0,0"
                                                    Foreground="{ThemeResource SignalBrush}"
                                                    Values="{x:Bind SignalHistory}" />
                            </Grid>

                            <StackPanel Grid.Column="7" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CellStyle}" Text="{x:Bind FirmwareText, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind UpdateText, Mode=OneWay}" FontSize="11"
                                           Foreground="{ThemeResource UpdateBrush}" TextTrimming="CharacterEllipsis"
                                           Visibility="{x:Bind HasUpdate, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>

                            <Grid Grid.Column="8" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CellStyle}" Text="{x:Bind ComplianceText, Mode=OneWay}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"
                                           Visibility="{x:Bind IsDrifted, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
                                <Border Style="{StaticResource PillStyle}" HorizontalAlignment="Left"
                                        Background="{ThemeResource DriftFillBrush}"
                                        Visibility="{x:Bind IsDrifted, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{x:Bind ComplianceText, Mode=OneWay}" Style="{StaticResource BadgeTextStyle}"
                                               Foreground="{ThemeResource DriftBrush}" />
                                </Border>
                            </Grid>

                            <StackPanel Grid.Column="9" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                <Button Content="&#xE7B3;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                        IsEnabled="{x:Bind IsControllable, Mode=OneWay}" Click="OnRowIdentify"
                                        ToolTipService.ToolTip="{x:Bind Loc.Get('action.identify'), Mode=OneWay}" />
                                <Button Content="&#xE946;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                        Click="OnRowDetails"
                                        ToolTipService.ToolTip="{x:Bind Loc.Get('action.info'), Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"
                       TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center" IsHitTestVisible="False"
                       Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

            </Grid>
        </ScrollViewer>
        </Border>

        <!-- Journal -->
        <Expander Grid.Row="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                  Header="{x:Bind ViewModel.Loc.Get('log.title'), Mode=OneWay}">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="200" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
                    <Button Content="{x:Bind ViewModel.Loc.Get('log.clear'), Mode=OneWay}" Click="OnClearLog" />
                    <Button Content="{x:Bind ViewModel.Loc.Get('log.export'), Mode=OneWay}" Click="OnExportLog" />
                </StackPanel>

                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.LogEntries, Mode=OneWay}"
                          SelectionMode="Single" SelectionChanged="OnLogSelected">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:LogRow">
                            <Grid ColumnSpacing="10" Padding="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind Time}" FontFamily="Consolas" FontSize="12" Opacity="0.6" />
                                <TextBlock Grid.Column="1" Text="{x:Bind DeviceId}" FontFamily="Consolas" FontSize="12" Opacity="0.8" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Message}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Detail}" FontSize="12" Opacity="0.6"
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Expander>

        <!-- Barre d'état -->
        <Grid Grid.Row="4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="{x:Bind ViewModel.Loc.Get('action.selectAll'), Mode=OneWay}" Click="OnSelectAll" />
            <Button Grid.Column="1" Content="{x:Bind ViewModel.Loc.Get('action.inverseSelection'), Mode=OneWay}" Click="OnInvertSelection" />
            <Button Grid.Column="2" Content="{x:Bind ViewModel.Loc.Get('action.clearSelection'), Mode=OneWay}" Click="OnClearSelection" />

            <TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="12,0" Opacity="0.75"
                       TextTrimming="CharacterEllipsis" Text="{x:Bind ViewModel.Status, Mode=OneWay}" />

            <ProgressRing Grid.Column="4" Width="20" Height="20"
                          IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
